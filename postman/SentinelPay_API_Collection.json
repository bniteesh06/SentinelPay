            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"BLOCKED\",\n  \"notes\": \"Confirmed spoofed location and velocity burst\",\n  \"reviewerName\": \"Niteesh Balajee\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/TXN-9042/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "TXN-9042",
                "review"
              ]
            }
