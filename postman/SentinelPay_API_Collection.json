          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"Robert King\",\n  \"amount\": 6500.00,\n  \"origin\": \"foreign_high_risk\",\n  \"timeHour\": 2,\n  \"velocity\": 5,\n  \"locationMatch\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "Submit a transaction for dual-layer fraud scoring. Should trigger multiple rules and FLAGGED status."
          }
        },
        {
          "name": "2. Evaluate & Ingest Transaction (Safe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"Emily Watson\",\n  \"amount\": 45.00,\n  \"origin\": \"domestic\",\n  \"timeHour\": 14,\n  \"velocity\": 1,\n  \"locationMatch\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "Submit a standard transaction. Should result in SAFE status (<30 risk)."
          }
        },
        {
          "name": "3. Get All Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "4. Get Flagged Review Queue Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?status=FLAGGED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "FLAGGED"
                }
              ]
            }
          }
        },
        {
          "name": "5. Analyst Triage: Confirm Fraud (Block)",
          "request": {
            "method": "PATCH",
            "header": [
